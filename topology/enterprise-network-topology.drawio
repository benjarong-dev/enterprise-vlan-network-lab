        <!-- Title Header -->
        <mxCell id="title-banner" value="&lt;b&gt;ENTERPRISE OFFICE &amp;amp; SERVER INFRASTRUCTURE — LOGICAL NETWORK TOPOLOGY&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px; color: #475569;&quot;&gt;Architecture: Router-on-a-Stick | 802.1Q VLAN Segmentation | Omada SDN Centralized Management | RSTP (802.1w)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#cbd5e1;fontColor=#0f172a;fontSize=14;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1440" height="50" as="geometry" />
        </mxCell>

        <!-- IP Plan & Legend Table -->
        <mxCell id="ip-legend" value="&lt;b style=&quot;font-size: 12px; color: #0f172a;&quot;&gt;IP ADDRESSING &amp;amp; VLAN ALLOCATION PLAN&lt;/b&gt;&lt;hr style=&quot;border: 0; border-top: 1px solid #cbd5e1; margin: 6px 0;&quot;&gt;&lt;table style=&quot;width: 100%; border-collapse: collapse; font-size: 10.5px; color: #1e293b;&quot;&gt;&lt;tr style=&quot;background-color: #e2e8f0; text-align: left;&quot;&gt;&lt;th style=&quot;padding: 4px;&quot;&gt;VLAN&lt;/th&gt;&lt;th style=&quot;padding: 4px;&quot;&gt;Zone&lt;/th&gt;&lt;th style=&quot;padding: 4px;&quot;&gt;Subnet (GW .1)&lt;/th&gt;&lt;th style=&quot;padding: 4px;&quot;&gt;Switch Ports&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding: 4px;&quot;&gt;&lt;b&gt;VLAN 10&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding: 4px;&quot;&gt;Mgmt&lt;/td&gt;&lt;td style=&quot;padding: 4px;&quot;&gt;192.168.10.0/24&lt;/td&gt;&lt;td style=&quot;padding: 4px;&quot;&gt;Gi0/1 - Gi0/4 (Access)&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color: #f8fafc;&quot;&gt;&lt;td style=&quot;padding: 4px;&quot;&gt;&lt;b&gt;VLAN 20&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding: 4px;&quot;&gt;Servers&lt;/td&gt;&lt;td style=&quot;padding: 4px;&quot;&gt;192.168.20.0/24&lt;/td&gt;&lt;td style=&quot;padding: 4px;&quot;&gt;Te0/1, Gi0/5-12 (Trunk 10,20)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding: 4px;&quot;&gt;&lt;b&gt;VLAN 30&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding: 4px;&quot;&gt;Staff/WiFi&lt;/td&gt;&lt;td style=&quot;padding: 4px;&quot;&gt;192.168.30.0/24&lt;/td&gt;&lt;td style=&quot;padding: 4px;&quot;&gt;Gi0/13-20 (Native 10, Trunk 30,40)&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color: #f8fafc;&quot;&gt;&lt;td style=&quot;padding: 4px;&quot;&gt;&lt;b&gt;VLAN 40&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding: 4px;&quot;&gt;IoT/CCTV&lt;/td&gt;&lt;td style=&quot;padding: 4px;&quot;&gt;192.168.40.0/24&lt;/td&gt;&lt;td style=&quot;padding: 4px;&quot;&gt;Gi0/21 - Gi0/23 (Access)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding: 4px;&quot;&gt;&lt;b&gt;Uplink&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding: 4px;&quot;&gt;Firewall&lt;/td&gt;&lt;td style=&quot;padding: 4px;&quot;&gt;802.1Q Trunk&lt;/td&gt;&lt;td style=&quot;padding: 4px;&quot;&gt;Gi0/24 &amp;lt;-&amp;gt; FW Gi0/1&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color: #f8fafc;&quot;&gt;&lt;td style=&quot;padding: 4px;&quot;&gt;&lt;b&gt;VPN&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding: 4px;&quot;&gt;Remote&lt;/td&gt;&lt;td style=&quot;padding: 4px;&quot;&gt;10.8.0.0/24&lt;/td&gt;&lt;td style=&quot;padding: 4px;&quot;&gt;IPSec / SSL Tunnel&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;hr style=&quot;border: 0; border-top: 1px solid #cbd5e1; margin: 6px 0;&quot;&gt;&lt;div style=&quot;font-size: 10.5px; color: #334155; line-height: 1.45;&quot;&gt;&lt;b&gt;Static Infrastructure IPs:&lt;/b&gt;&lt;br&gt;• Omada SDN Controller: &lt;code&gt;192.168.10.5&lt;/code&gt;&lt;br&gt;• Proxmox/KVM Hypervisor: &lt;code&gt;192.168.10.10&lt;/code&gt;&lt;br&gt;• Windows Server (AD/DNS/DHCP): &lt;code&gt;192.168.20.10&lt;/code&gt;&lt;br&gt;• Ubuntu Linux (Python API): &lt;code&gt;192.168.20.20&lt;/code&gt;&lt;br&gt;• Grafana Telemetry Server: &lt;code&gt;192.168.20.30&lt;/code&gt;&lt;br&gt;&lt;b&gt;Security Policy:&lt;/b&gt; Stateful nftables ACL blocks VLAN 40 from initiating traffic to RFC1918 internal subnets.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f8fafc;strokeColor=#94a3b8;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="430" height="365" as="geometry" />
