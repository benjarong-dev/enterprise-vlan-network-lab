  <diagram name="Enterprise Network Topology" id="ent-net-v3">
    <mxGraphModel dx="1560" dy="980" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="0" fold="1" page="1" pageScale="1" pageWidth="1520" pageHeight="940" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
